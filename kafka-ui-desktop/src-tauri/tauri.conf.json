{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kafka UI",
  "version": "0.0.1",
  "identifier": "com.provectus.kafkaui.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kafka UI",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "resources/kafka-ui-api.jar": "kafka-ui-api.jar",
      "resources/runtime/": "runtime/"
    }
  }
}
